[Unit]
Description=vr-telex Vietnamese Telex input method
PartOf=graphical-session.target
After=graphical-session.target
# Restart forever (SEC-17): no start rate limit, so a cause that fails fast
# (another instance holding the lock, a refused address file, no display yet)
# never leaves the unit in start-limit-hit once it is gone. The back-off in
# [Service] keeps such a loop slow instead.
StartLimitIntervalSec=0

[Service]
# The daemon sends READY=1 once it owns its D-Bus names and has written the
# IBus address file, then WATCHDOG=1 from the key loop at least every
# WatchdogSec/2 (it reads WATCHDOG_USEC), so a hung daemon is restarted (SEC-18).
Type=notify
NotifyAccess=main
ExecStart="%h/.local/bin/vr-telex"
Restart=always
# The first restart comes after 1 s (D22); repeated ones back off to at most
# 15 s. A long healthy run does not reset systemd's restart count, so the
# cap also bounds how long keys stay raw after a crash late in the session.
RestartSec=1
RestartSteps=4
RestartMaxDelaySec=15
TimeoutStartSec=10
WatchdogSec=10

# No core dumps: memory holds keystrokes (SEC-3).
LimitCORE=0
# Hardening that works in a user manager without user namespaces (SEC-28);
# Ubuntu 24.04 restricts unprivileged user namespaces, so Protect*/Private*
# options would make the unit fail to start.
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=graphical-session.target
