#!/bin/sh
# Runs as root under dpkg. Per-user files are never deleted here: they sit
# in users' home directories and `vr-telex-setup --remove` restores the
# settings they were backed up from.
#
# The apt source written by postinst goes on remove (not only on purge): its
# keyring is a package file that dpkg deletes on remove, and a source without
# its key makes every `apt update` fail. DPKG_ROOT: see postinst.
set -e

SOURCE_FILE="$DPKG_ROOT/etc/apt/sources.list.d/vr-telex.sources"

case "$1" in
remove | purge)
  rm -f "$SOURCE_FILE" "$SOURCE_FILE.dpkg-new"
  ;;
esac

case "$1" in
purge)
  echo "vr-telex: per-user files in home directories are kept. For a user who did not" >&2
  echo "vr-telex: run 'vr-telex-setup --remove' first, the" >&2
  echo "vr-telex: input method settings still point at vr-telex, so neither fcitx5" >&2
  echo "vr-telex: nor Vietnamese input starts at login:" >&2
  echo "vr-telex: ~/.local/share/dbus-1/services/org.fcitx.Fcitx5.service, ~/.xinputrc," >&2
  echo "vr-telex: ~/.config/autostart/org.fcitx.Fcitx5.desktop and the vr-telex.service" >&2
  echo "vr-telex: enable link in ~/.config/systemd/user. To restore that user's setup," >&2
  echo "vr-telex: reinstall vr-telex, run 'vr-telex-setup --remove' as that user, then" >&2
  echo "vr-telex: purge again. The saved setup is in ~/.local/share/vr-telex." >&2
  ;;
esac

exit 0
