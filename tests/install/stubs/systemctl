#!/usr/bin/env bash
# Sandbox stand-in for "systemctl --user": a tiny service manager for the
# units of the sandbox HOME. "start" emulates Type=notify readiness: the job
# succeeds once the daemon owns org.fcitx.Fcitx5 and is still alive.
set -euo pipefail
st="${XDG_RUNTIME_DIR:?}/stub-systemd"
mkdir -p "$st"
printf 'systemctl %s\n' "$*" >>"$XDG_RUNTIME_DIR/stub-calls.log"

[ "${1:-}" = --user ] || { echo "stub systemctl: only --user is supported" >&2; exit 2; }
shift
quiet=0 now=0 prop='' value=0
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -q | --quiet) quiet=1 ;;
    --now) now=1 ;;
    --value) value=1 ;;
    -p) prop=$2; shift ;;
    -*) echo "stub systemctl: unsupported option $1" >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done
cmd=${args[0]:-}
unit=${args[1]:-}
unitdir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
wants="$unitdir/graphical-session.target.wants"

main_pid() {
  local f="$st/$1.pid" pid
  [ -f "$f" ] || return 1
  pid=$(cat "$f")
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

start_unit() {
  local u=$1 file exec pid
  main_pid "$u" >/dev/null && return 0
  file="$unitdir/$u"
  [ -f "$file" ] || { echo "Failed to start $u: Unit $u not found." >&2; return 5; }
  exec=$(sed -n 's/^ExecStart=//p' "$file")
  exec=${exec//%h/"$HOME"}
  # The unit quotes the path; this stub runs a single word.
  exec=${exec#\"}
  exec=${exec%\"}
  setsid "$exec" </dev/null >>"$st/$u.log" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" >"$st/$u.pid"
  if gdbus wait --session --timeout "${STUB_START_TIMEOUT:-3}" org.fcitx.Fcitx5 && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  rm -f "$st/$u.pid"
  echo "Job for $u failed because the control process exited with error code." >&2
  return 1
}

stop_unit() {
  local u=$1 pid
  pid=$(main_pid "$u") || { rm -f "$st/$u.pid"; return 0; }
  kill -TERM "$pid"
  timeout 5 tail --pid="$pid" -f /dev/null || true
  rm -f "$st/$u.pid"
}

case "$cmd" in
  daemon-reload) ;;
  start) start_unit "$unit" ;;
  stop) stop_unit "$unit" ;;
  restart) stop_unit "$unit"; start_unit "$unit" ;;
  try-restart) if main_pid "$unit" >/dev/null; then stop_unit "$unit"; start_unit "$unit"; fi ;;
  enable)
    [ -f "$unitdir/$unit" ] || { echo "Failed to enable unit: Unit file $unit does not exist." >&2; exit 1; }
    if [ ! -L "$wants/$unit" ]; then
      mkdir -p "$wants"
      ln -s "$unitdir/$unit" "$wants/$unit"
    fi
    if [ "$now" = 1 ]; then start_unit "$unit"; fi
    ;;
  disable)
    rm -f "$wants/$unit"
    if [ "$now" = 1 ]; then stop_unit "$unit"; fi
    ;;
  is-active)
    if main_pid "$unit" >/dev/null; then
      [ "$quiet" = 1 ] || echo active
      exit 0
    fi
    [ "$quiet" = 1 ] || echo inactive
    exit 3
    ;;
  is-enabled)
    if [ -L "$wants/$unit" ]; then
      [ "$quiet" = 1 ] || echo enabled
      exit 0
    fi
    if [ -f "$unitdir/$unit" ]; then
      [ "$quiet" = 1 ] || echo disabled
    else
      [ "$quiet" = 1 ] || echo not-found
    fi
    exit 1
    ;;
  show)
    [ "$prop" = MainPID ] || { echo "stub systemctl: show supports -p MainPID only" >&2; exit 2; }
    pid=$(main_pid "$unit") || pid=0
    if [ "$value" = 1 ]; then echo "$pid"; else echo "MainPID=$pid"; fi
    ;;
  *) echo "stub systemctl: unsupported command $cmd" >&2; exit 2 ;;
esac
